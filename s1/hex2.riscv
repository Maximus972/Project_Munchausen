# hex2 — ступень S1. Цель: rv32i, RISC-V, qemu-riscv32.
# Вызов: qemu-riscv32 ./hex2 input.hex2 output.bin
#
# Строка "rv32" в шапке нужна, чтобы автодетект в emacs выбрал 32 бита,
# а не дефолтные 64.

# ============================================================
#  Регистры (сквозные, живут весь прогон — не затирать в подпрограммах)
# ============================================================
#   s0  fd входного файла
#   s1  fd выходного файла
#   s2  флаг "половинка накоплена"
#   s3  накопленная половинка (старший ниббл)
#   s4  позиция в выходном буфере (она же значение метки)
#   s5  номер прохода: 0 или 1
#   s6  флаг "внутри комментария"
#   s7  количество меток в таблице
#   s8  ??? свободен
#   t0-t6  временные, живут только внутри блока
#   a0-a7  аргументы syscall, портятся после каждого ecall

# ============================================================
#  Карта памяти. Сегмент 2: 0x18000 .. 0x1FFFF (32 КБ) — и ни байтом больше
# ============================================================
#   0x18000  скаляры, если понадобятся          256 б
#   0x18100  буфер чтения (1 байт на read)      256 б
#   0x18200  пул имён меток, через \0          ~7.5 КБ
#   0x1A000  таблица меток, 16 б на запись        8 КБ  (512 меток)
#   0x1C000  выходной буфер                      16 КБ
#
#   Запись таблицы: [0] смещение имени в пуле, [4] значение, [8..15] резерв


.section .bss
# --- БАЗА 0x18000 (lui a1, 24) ---
.org 0x18000
buf_read:
    .space 1           # Буфер чтения (1 байт)

.org 0x18100
buf_name:
    .space 16          # Буфер имени (16 байт)

# --- БАЗА 0x1A000 (lui a1, 26) ---
.org 0x1A000
label_table:
    .space 8192        # Таблица меток (8 КБ, 512 записей по 16 байт)

# --- БАЗА 0x1C000 (lui a1, 28) ---
.org 0x1C000
buf_out:
    .space 16384       # Выходной буфер (16 КБ)

.section .data

.align 4

.equ label_name, 0
.equ label_pos, 12
.equ label_size, 16

name_array:
    .space label_size * 16

.global _start
.section .text

_start:
    # --- пролог: обнулить сквозные регистры ---
    addi s0, zero, 0                    # Дескриптор входного файла
    addi s1, zero, 0                    # Дескриптор выходного файла
    addi s2, zero, 0                    # Половинка есть
    addi s3, zero, 0                    # Накопленная половина
    addi s4, zero, 0                    # Позиция в буфере вывода
    addi s5, zero, 0                    # Номер прохода
    addi s6, zero, 0                    # Флаг комментарий
    addi s7, zero, 0                    # Адрес выходного файла
    addi t0, zero, 0                    # Временный регистр
    addi t1, zero, 0                    # Временный регистр

    # --- сохранить argv[1] и argv[2]: имена файлов ---
    lw t0, 4(sp)
    lw t1, 8(sp)
    lw t2, 12(sp)

    addi a0, zero, -100
    addi a1, t1, 0
    addi a2, zero, 0
    addi a3, zero, 0
    addi a7, zero, 56
    ecall                               # Открываем входной файл, дескриптор файла в a0

    addi s0, a0, 0                      # Дескриптор ставим в регистр s0, как и указали вначале

    addi a0, zero, -100
    addi a1, t2, 0
    addi a2, zero, 577
    addi a3, zero, 420
    addi a7, zero, 56
    ecall                               # Открываем выходной файл, дескриптор файла в a0

    addi s1, a0, 0                      # Дескриптор выходного файла помещаем в s1
    ## beq zero, zero, exit_ok
# ============================================================
#  ПРОХОД 1: собрать таблицу меток
# ============================================================
pass1:


# ============================================================
#  ПРОХОД 2: эмитировать байты, разрешить ссылки
# ============================================================
pass2:


# ============================================================
#  Запись выходного буфера в файл одним write
# ============================================================
flush:


# ------------------------------------------------------------
#  Подпрограммы
# ------------------------------------------------------------

# читает один байт из s0 в t0; при EOF уходит на eof
read_byte:
    addi a0, s0, 0
    lui a1, 24
    addi a2, zero, 1
    addi a7, zero, 63
    ecall

    blt a0, zero, exit_err
    beq a0, zero, exit_ok
    ## beq zero, zero, emit_byte
    lui a1, 24
    lbu t0, 0(a1)

    lui a1, 28
    add a1, a1, s4
    sb t0, 0(a1)

    addi s4, s4, 1
    beq zero, zero, read_byte
# t0 — hex-цифра, вернуть значение 0..15
hex_digit:

# записать байт t0 в выходной буфер, s4 += 1
emit_byte:

# прочитать имя после : ~ @ &  в буфер имени
read_name:

# найти имя в таблице; вернуть значение или "не найдено"
lookup:

# добавить имя в таблицу со значением s4
define:

# пропатчить слово по адресу (s4 - 4) как jal
patch_j:

# пропатчить слово по адресу (s4 - 4) как branch
patch_b:

exit_ok:
    addi a7, zero, 64
    addi a0, s1, 0
    lui a1, 28
    addi a2, s4, 0
    ecall

    addi a0, zero, 0
    addi a7, zero, 93
    ecall

exit_err:
    addi a0, zero, 1
    addi a7, zero, 93
    ecall
