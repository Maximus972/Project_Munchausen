# hex0 — ступень S0 проекта bootstrap
# Переводит шестнадцатеричный текст в байты.
# Вызов: qemu-riscv32 ./hex0 вход.hex выход.bin
# Комментарий — от # или ; до конца строки.

# ================= ELF header (52 байта) =================
7F 45 4C 46                # magic 7F 'E' 'L' 'F'
01                         # ELFCLASS32
01                         # порядок байтов: младший вперёд
01                         # версия ELF
00 00 00 00 00 00 00 00 00 # OSABI + выравнивание
02 00                      # e_type = EXEC
F3 00                      # e_machine = RISC-V (243)
01 00 00 00                # e_version
74 00 01 00                # e_entry = 0x10074
34 00 00 00                # e_phoff = 52
00 00 00 00                # e_shoff = 0
00 00 00 00                # e_flags = 0
34 00                      # e_ehsize = 52
20 00                      # e_phentsize = 32
02 00                      # e_phnum = 2
28 00                      # e_shentsize = 40
00 00                      # e_shnum = 0
00 00                      # e_shstrndx = 0

# ========== Phdr 1: код, R+X, из файла (32 байта) ==========
01 00 00 00                # p_type = LOAD
00 00 00 00                # p_offset = 0
00 00 01 00                # p_vaddr = 0x10000
00 00 01 00                # p_paddr = 0x10000
00 10 00 00                # p_filesz = 0x1000
00 10 00 00                # p_memsz = 0x1000
07 00 00 00                # p_flags = RWX
00 10 00 00                # p_align = 0x1000

# ===== Phdr 2: данные, R+W, ничего из файла (32 байта) =====
01 00 00 00                # p_type = LOAD
00 00 00 00                # p_offset = 0
00 80 01 00                # p_vaddr = 0x18000
00 80 01 00                # p_paddr = 0x18000
00 00 00 00                # p_filesz = 0 — чистая память
00 80 00 00                # p_memsz = 0x8000 — 32 КБ
06 00 00 00                # p_flags = RW
00 10 00 00                # p_align = 0x1000

# ===================== код (0x74) =====================

# --- инициализация: s2 признак половинки, s3 половинка, t2 флаг комментария ---
13 09 00 00                # 074  addi s2, zero, 0
93 09 00 00                # 078  addi s3, zero, 0
93 03 00 00                # 07C  addi t2, zero, 0

# --- открыть входной файл, номер в s0 ---
83 25 81 00                # 080  lw a1, 8(sp)
13 05 C0 F9                # 084  addi a0, zero, -100
13 06 00 00                # 088  addi a2, zero, 0
93 06 00 00                # 08C  addi a3, zero, 0
93 08 80 03                # 090  addi a7, zero, 56
73 00 00 00                # 094  ecall
13 04 05 00                # 098  addi s0, a0, 0

# --- открыть выходной файл, номер в s1 ---
83 25 C1 00                # 09C  lw a1, 12(sp)
13 05 C0 F9                # 0A0  addi a0, zero, -100
13 06 10 24                # 0A4  addi a2, zero, 577
93 06 40 1A                # 0A8  addi a3, zero, 420
93 08 80 03                # 0AC  addi a7, zero, 56
73 00 00 00                # 0B0  ecall
93 04 05 00                # 0B4  addi s1, a0, 0

# --- read_byte: прочитать один байт ---
13 05 04 00                # 0B8  addi a0, s0, 0
B7 85 01 00                # 0BC  lui a1, 24
13 06 10 00                # 0C0  addi a2, zero, 1
93 08 F0 03                # 0C4  addi a7, zero, 63
73 00 00 00                # 0C8  ecall
63 02 05 0C                # 0CC  beq a0, zero, exit
83 82 05 00                # 0D0  lb t0, 0(a1)

# --- комментарий? # и ; включают пропуск, перевод строки выключает ---
13 03 A0 00                # 0D4  addi t1, zero, 10
63 84 62 06                # 0D8  beq t0, t1, reset_flag
13 03 B0 03                # 0DC  addi t1, zero, 59
63 84 62 06                # 0E0  beq t0, t1, set_flag
13 03 30 02                # 0E4  addi t1, zero, 35
63 80 62 06                # 0E8  beq t0, t1, set_flag

# --- внутри комментария — пропускаем всё ---
13 0E 10 00                # 0EC  addi t3, zero, 1
E3 84 C3 FD                # 0F0  beq t2, t3, read_byte

# --- разбор символа по диапазонам ---
13 03 00 03                # 0F4  addi t1, zero, 48
E3 C0 62 FC                # 0F8  blt t0, t1, read_byte
13 03 A0 03                # 0FC  addi t1, zero, 58
63 C4 62 02                # 100  blt t0, t1, digit_handler
13 03 10 04                # 104  addi t1, zero, 65
E3 C8 62 FA                # 108  blt t0, t1, read_byte
13 03 70 04                # 10C  addi t1, zero, 71
63 C0 62 02                # 110  blt t0, t1, AF_handler
13 03 10 06                # 114  addi t1, zero, 97
E3 C0 62 FA                # 118  blt t0, t1, read_byte
13 03 70 06                # 11C  addi t1, zero, 103
63 CC 62 00                # 120  blt t0, t1, af_handler
E3 0A 00 F8                # 124  beq zero, zero, read_byte

# --- digit_handler: '0'-'9' ---
93 82 02 FD                # 128  addi t0, t0, -48
63 02 00 02                # 12C  beq zero, zero, write_byte

# --- AF_handler: 'A'-'F' ---
93 82 92 FC                # 130  addi t0, t0, -55
63 0E 00 00                # 134  beq zero, zero, write_byte

# --- af_handler: 'a'-'f' ---
93 82 92 FA                # 138  addi t0, t0, -87
63 0A 00 00                # 13C  beq zero, zero, write_byte

# --- reset_flag ---
93 03 00 00                # 140  addi t2, zero, 0
E3 0A 00 F6                # 144  beq zero, zero, read_byte

# --- set_flag ---
93 03 10 00                # 148  addi t2, zero, 1
E3 06 00 F6                # 14C  beq zero, zero, read_byte

# --- write_byte: первая цифра или вторая ---
13 0E 10 00                # 150  addi t3, zero, 1
63 08 C9 01                # 154  beq s2, t3, s2_handler
93 89 02 00                # 158  addi s3, t0, 0
13 09 10 00                # 15C  addi s2, zero, 1
E3 0C 00 F4                # 160  beq zero, zero, read_byte

# --- s2_handler: собрать байт из пары ---
93 99 49 00                # 164  slli s3, s3, 4
B3 82 59 00                # 168  add t0, s3, t0
13 09 00 00                # 16C  addi s2, zero, 0
63 02 00 00                # 170  beq zero, zero, write_byte_final

# --- write_byte_final: положить байт в буфер и записать ---
13 85 04 00                # 174  addi a0, s1, 0
B7 85 01 00                # 178  lui a1, 24
23 80 55 00                # 17C  sb t0, 0(a1)
13 06 10 00                # 180  addi a2, zero, 1
93 08 00 04                # 184  addi a7, zero, 64
73 00 00 00                # 188  ecall
E3 06 00 F2                # 18C  beq zero, zero, read_byte

# --- exit ---
13 05 00 00                # 190  addi a0, zero, 0
93 08 D0 05                # 194  addi a7, zero, 93
73 00 00 00                # 198  ecall

# ===================== хвост =====================
00 00 00 00                # выравнивание
